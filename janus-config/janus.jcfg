general: {
    # ------------------------------------------------------------------------
    # Performance / scalability
    # ------------------------------------------------------------------------
    # Number of static event-loop threads handles are distributed across.
    # The entrypoint overrides this at startup with the host vCPU count
    # (nproc); set JANUS_EVENT_LOOPS in the environment to pin it explicitly.
    # With many concurrent sessions this avoids one-thread-per-handle churn.
    event_loops = 4

    session_timeout = 60
    reclaim_session_timeout = 30

    # Logging. debug_level is overridden at startup by JANUS_DEBUG_LEVEL.
    # 4 = info. For maximum throughput under heavy traffic use 3 (warn) — at
    # high call churn level-4 stdout logging is a real IO cost.
    debug_level = 4
    debug_timestamps = true
    debug_colors = false
    debug_stdout = true
}

media: {
    ipv6 = false

    # ------------------------------------------------------------------------
    # WebRTC media (browser <-> Janus) RTP/RTCP port range.
    #
    # Audio-only + rtcp-mux ~= 1 UDP port per PEER CONNECTION, so this NARROW
    # window of 201 ports = ~200 concurrent peer connections -- deliberately
    # small so the ENTIRE range can be trivially and fully opened in the Hetzner
    # Cloud Firewall (UDP 20000-20200 inbound). A partially-open range is what
    # makes ICE succeed for some calls and fail (call drops ~20s later) for
    # others.
    #
    # NOTE the unit: PEER CONNECTIONS, not calls. That used to be the same
    # number; with conferencing it is not. A conference of P remote participants
    # costs 2P + 1 peer connections on this range -- P for the SIP legs, plus
    # P + 1 AudioBridge participants (one per leg, one for the agent). So one
    # agent in a full 5-party conference holds 11 ports where five calls used to
    # hold 5. Budget from the peer-connection count, not the call count.
    #
    # Widen this back toward 32766 ONLY after confirming the firewall opens the
    # whole range -- do NOT widen it to buy conference headroom while the
    # firewall still stops at 20200, which is precisely the partially-open case
    # above. Kept DISJOINT from the SIP-side range (10000-19998 in
    # janus.plugin.sip.jcfg) and BELOW the kernel ephemeral range (32768+).
    # ------------------------------------------------------------------------
    rtp_port_range = "20000-20200"
}

nat: {
    # ========================================================================
    # CRITICAL: NAT 1:1 MAPPING - server's PUBLIC IP (overridden at startup
    # from NAT_PUBLIC_IP). Required because the host NIC sees a private IP
    # behind 1:1 NAT; this is the address advertised in ICE candidates.
    # ========================================================================
    nat_1_1_mapping = "5.78.103.238"

    # Advertise only the public IP, not the unreachable private/host IP.
    keep_private_host = false

    # ICE-Lite: Janus is the controlled agent with a single static host
    # candidate (the public IP above).
    ice_lite = true

    # Half-trickle (full_trickle = false): embed the ICE candidate directly in
    # the SDP instead of trickling it separately. REQUIRED for ice_lite, where
    # there is a single static host candidate. With full_trickle = true Janus
    # OMITS the candidate from the SDP and trickles it; on the offerer leg
    # (inbound SIP -> WebRTC agent) that trickle was being lost, leaving the
    # callee browser with no remote candidate so ICE never started.
    full_trickle = false

    # Drop remote .local mDNS candidates instead of trying (and failing) to
    # resolve them in the container.
    ignore_mdns = true

    # No STUN: an ICE-Lite agent does not gather server-reflexive candidates,
    # so a STUN server is unused. Removing it also avoids a startup DNS lookup.

    # Ignore container/virtual interfaces when gathering candidates.
    ice_ignore_list = "docker0,br-,veth,lo"
}

plugins: {
    # Two plugins are used, and ONLY two:
    #
    #   janus.plugin.sip         — every call leg (browser <-> Janus <-> PortaSIP).
    #   janus.plugin.audiobridge — the conference mixer.
    #
    # AudioBridge is REQUIRED for the dialer's conference feature and was
    # previously disabled here. The dialer publishes each SIP leg into an
    # AudioBridge room as its own participant and writes the mix the room returns
    # for it (everyone except that party) back onto that leg — so the mixing is
    # the plugin's and the relaying is the browser's. With this disabled, the
    # dialer's first `attach` for a conference fails with "No such plugin" and
    # nothing about conferencing works. See janus.plugin.audiobridge.jcfg, and
    # arcsip_new_mvp/docs/sip-integration.md#conference-janus-audiobridge.
    #
    # AudioBridge needs libopus at BUILD time. Confirm on first deploy that the
    # base image actually shipped it — the startup log must contain
    # "JANUS AudioBridge plugin initialised".
    #
    # Everything else stays off: it cuts memory, startup time and attack surface.
    # (Listing a plugin that isn't built is harmless.)
    disable = "libjanus_videoroom.so,libjanus_streaming.so,libjanus_videocall.so,libjanus_voicemail.so,libjanus_textroom.so,libjanus_recordplay.so,libjanus_echotest.so,libjanus_nosip.so,libjanus_duktape.so,libjanus_lua.so"
}

transports: {
    # Only the WebSocket transport is used. HTTP/Unix-socket/etc. disabled.
    disable = "libjanus_http.so,libjanus_pfunix.so,libjanus_rabbitmq.so,libjanus_mqtt.so,libjanus_nanomsg.so"
}
