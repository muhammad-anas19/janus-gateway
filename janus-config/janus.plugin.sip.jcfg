general: {
    # NOTE: the SIP plugin only reads a 'general' section. Options such as
    # codec lists, session timers, transport, retry policy and per-call
    # direction are negotiated PER CALL via the Janus API, not here — the
    # previous registration{}/sip{}/rtp{}/events{} blocks (and options like
    # local_media_server, hold_sdp, rtp_ip) were silently ignored by Janus
    # and have been removed.

    # Public IP advertised in the SDP toward the SIP peer (overridden at
    # startup from NAT_PUBLIC_IP).
    sdp_ip = "5.78.103.238"

    # We are behind 1:1 NAT.
    behind_nat = true

    user_agent = "ARCSIP-Janus/1.0"

    # Registration lifetime (seconds) and keep-alive to hold the registration
    # and NAT binding open.
    register_ttl = 300
    keepalive_interval = 60

    # ------------------------------------------------------------------------
    # SIP-side (plain RTP/RTCP) media port range (~5k calls at 2 ports each).
    # THIS is the valid option (a "min-max" string in 'general') — the old
    # rtp{ rtp_port_min/max } block was ignored, so the SIP leg was using
    # Janus's default ports. Kept DISJOINT from the WebRTC range (20000-32766),
    # below the kernel ephemeral range, and must be open in the host firewall.
    # ------------------------------------------------------------------------
    rtp_port_range = "10000-19998"

    # DSCP Expedited Forwarding marking on audio RTP for QoS where honoured.
    dscp_audio_rtp = 46

    # No event-handler plugins are loaded, so don't bother emitting events.
    events = false
}
